# ===== Ollama (LLM lokal) =====
OLLAMA_HOST=http://localhost:11434
# Model harus mendukung tool calling.
# Ringan (2 GB): llama3.2:3b — Lebih pintar (4.9 GB): llama3.1
# Jalankan: ollama pull llama3.2:3b
OLLAMA_MODEL=llama3.2:3b
# (Opsional) Batas konteks token. Kecilkan untuk hemat RAM di mesin kecil.
# OLLAMA_NUM_CTX=2048

# ===== Telegram =====
# Buat bot lewat @BotFather di Telegram (/newbot), lalu tempel tokennya di sini.
TELEGRAM_BOT_TOKEN=

# ===== Aktifkan / nonaktifkan channel =====
ENABLE_TELEGRAM=true
ENABLE_WHATSAPP=true

# ===== Zona waktu (dipakai tool tanggal/waktu & penjadwal) =====
TZ=Asia/Jakarta

# ===== Dukungan grup (Telegram & WhatsApp) =====
# Agent hanya merespons di grup bila di-mention atau pesan diawali prefix.
ENABLE_GROUPS=false
GROUP_PREFIX=!ai

# ===== Ringkasan berita harian =====
# Jam pengiriman (HH:MM, zona waktu TZ)
NEWS_DIGEST_TIME=07:00

# ===== (Opsional) Kustomisasi kepribadian agent =====
# SYSTEM_PROMPT=
